# Copy to .env.local and fill in. Placeholders only: never commit real keys.
# See the Configuration section of README.md for what each one does.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (test keys in development)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# The site itself
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_...
# Production: a sender on a domain verified in Resend
RESEND_FROM_EMAIL=
# Team inbox for enquiries, support and staff alerts (defaults to hello@inspire9.com)
SUPPORT_INBOX=
# Development only: send every email to this one address
RESEND_TO_OVERRIDE=

# Production: protects the weekly review-reminder job
CRON_SECRET=
